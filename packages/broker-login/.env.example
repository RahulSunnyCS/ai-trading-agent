# Copy to .env for local runs. .env is gitignored - never commit real values.
# In GitHub Actions these come from repository secrets instead.

# AlgoTest website login.
# AlgoTest logs in with a +91 phone number, NOT an email. Give the 10 digits;
# a leading +91 or 0 is stripped automatically.
ALGOTEST_PHONE=
ALGOTEST_PASSWORD=

# Angel One - entered on Angel One's own login page after the redirect.
# TOTP_SECRET is the base32 setup string, not a rotating 6-digit code.
ANGELONE_CLIENT_CODE=
ANGELONE_MPIN=
ANGELONE_TOTP_SECRET=

# Finvasia / Shoonya - entered in the inline form on AlgoTest
SHOONYA_CLIENT_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=

# Telegram reporting (optional - omit and results only go to stdout)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local development toggles
# HEADED=1           # show the browser
# SLOW_MO=250        # ms delay between actions, for watching it work
# SKIP_WINDOW_GUARD=1  # bypass the "wait until 08:31 IST" guard
# ONLY=shoonya       # run a single broker (shoonya | angelone)
