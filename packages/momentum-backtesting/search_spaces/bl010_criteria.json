    "aggressive": {
      "max_drawdown": -0.35,
      "or_relative": { "index": "Nifty Smallcap 250 TRI", "multiple": 1.2 },
      "hard_ceiling": -0.4
    }
  },
  "basket_drawdown_rule": "A strategy drawdown episode (peak to trough) passes if its depth is within max_drawdown, OR within multiple x the index's largest peak-to-trough fall inside the same window; in every case it must be within hard_ceiling. Every episode must pass.",
  "minimum_bar": {
    "benchmark": "Nifty200 Momentum 30 TRI",
    "excess_cagr_pts": 5,
    "after_tax": true
  },
  "comparators": [
    "Nifty200 Momentum 30 TRI",
    "Nifty Smallcap 250 TRI",
    "Nifty Midcap 150 TRI",
