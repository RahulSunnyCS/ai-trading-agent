<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Friday 21:00 IST forward-journal check (BL-024) — `mbt journal check --send`: did the
  14:40 / 16:45 / 19:30 runs record every favourite (and the Nifty200 Momentum 30 level) for
  this week, under this week, with the hash chain intact? Sends one Telegram summary either
  way. 21:00 leaves the 19:30 stock-ingest job (bhavcopy fetch + migrate + Broad backtests)
  time to finish. See the preview plist (same folder) for the timezone/sleep/`.env` caveats.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-trading-agent.momentum-weekly-journal-check</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>set -a; source /Users/rahul/Projects/ai-trading-agent/.env; set +a; cd /Users/rahul/Projects/ai-trading-agent/packages/momentum-backtesting &amp;&amp; /Users/rahul/.local/bin/uv run mbt journal check --send</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>5</integer>
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/rahul/Projects/ai-trading-agent/packages/momentum-backtesting/data/launchd-weekly-journal-check.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rahul/Projects/ai-trading-agent/packages/momentum-backtesting/data/launchd-weekly-journal-check.log</string>
</dict>
</plist>
