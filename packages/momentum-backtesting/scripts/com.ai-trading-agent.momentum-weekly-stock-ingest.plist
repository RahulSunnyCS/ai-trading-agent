<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Friday 19:30 IST stock-data ingest (TODO.md 3.11.5, B4) — `mbt stocks sync` (bhavcopy
  fetch + shared-DB migrate), then `mbt weekly --run final --only-dataset stock
  --only-dataset custom_index --only-dataset broad` so Stock/Custom Index/Broad Momentum
  favourites get a chance once the week's bhavcopy lands (NSE typically publishes it a
  few hours after close). The 16:45 final run has already sent an ETF favourite's signal
  by this point if one is active; `--only-dataset` keeps this rerun from resending it or
  reporting it as "blocked" — it only sends if the active favourite is one of these three.
  See the preview plist (same folder) for the timezone/sleep/`.env`-sourcing caveats.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-trading-agent.momentum-weekly-stock-ingest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>set -a; source /Users/rahul/Projects/ai-trading-agent/.env; set +a; cd /Users/rahul/Projects/ai-trading-agent/packages/momentum-backtesting &amp;&amp; /Users/rahul/.local/bin/uv run mbt stocks sync &amp;&amp; /Users/rahul/.local/bin/uv run mbt weekly --run final --only-dataset stock --only-dataset custom_index --only-dataset broad</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>5</integer>
        <key>Hour</key>
        <integer>19</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/rahul/Projects/ai-trading-agent/packages/momentum-backtesting/data/launchd-weekly-stock-ingest.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rahul/Projects/ai-trading-agent/packages/momentum-backtesting/data/launchd-weekly-stock-ingest.log</string>
</dict>
</plist>
