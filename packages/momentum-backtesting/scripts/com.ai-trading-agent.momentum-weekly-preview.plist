<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Friday 14:40 preview signal (live prices, before the 15:30 close) — TODO.md 3.11.5.
  StartCalendarInterval fires in the SYSTEM's local timezone, not UTC. This assumes the
  Mac's clock is set to IST (verified true on 2026-09-30 — `date` printed IST). If the
  timezone ever changes, these times drift with it; re-check `date` and edit Hour/Minute
  below if so.

  launchd only fires while the machine is awake (and, for a laptop, usually only on power
  or with "Wake for network access" — check System Settings > Battery if a Friday run gets
  missed). A missed run has no catch-up: this plist does not set RunAtLoad, so nothing
  fires retroactively if the Mac was asleep at 14:40.

  launchd's own environment does NOT include the repo's .env (TELEGRAM_BOT_TOKEN,
  TELEGRAM_CHAT_ID, FYERS_* — none of it) even though an interactive shell's usually
  does via shell profile sourcing; without it the job would compute a signal but
  silently never send it (notify.send() prints instead of raising when unset). The
  command below sources .env explicitly rather than relying on inherited environment,
  so this plist is self-contained and never holds a secret value itself.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-trading-agent.momentum-weekly-preview</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>set -a; source /Users/rahul/Projects/ai-trading-agent/.env; set +a; cd /Users/rahul/Projects/ai-trading-agent/packages/momentum-backtesting &amp;&amp; /Users/rahul/.local/bin/uv run mbt weekly --run preview</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>5</integer>
        <key>Hour</key>
        <integer>14</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/rahul/Projects/ai-trading-agent/packages/momentum-backtesting/data/launchd-weekly-preview.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rahul/Projects/ai-trading-agent/packages/momentum-backtesting/data/launchd-weekly-preview.log</string>
</dict>
</plist>
