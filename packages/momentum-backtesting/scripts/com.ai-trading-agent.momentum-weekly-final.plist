<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Friday 16:45 final signal (official closes) — TODO.md 3.11.5. See the preview plist
  (same folder) for the timezone/sleep/`.env`-sourcing caveats; identical here.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-trading-agent.momentum-weekly-final</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>set -a; source /Users/rahul/Projects/ai-trading-agent/.env; set +a; cd /Users/rahul/Projects/ai-trading-agent/packages/momentum-backtesting &amp;&amp; /Users/rahul/.local/bin/uv run mbt weekly --run final</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>5</integer>
        <key>Hour</key>
        <integer>16</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/rahul/Projects/ai-trading-agent/packages/momentum-backtesting/data/launchd-weekly-final.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rahul/Projects/ai-trading-agent/packages/momentum-backtesting/data/launchd-weekly-final.log</string>
</dict>
</plist>
