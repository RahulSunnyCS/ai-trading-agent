<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  08:00 IST weekdays: trigger the "Daily broker login" GitHub workflow (BL-011 Phase 1).
  This does not log in itself - packages/broker-login/src/dispatch.ts runs
  `gh workflow run`, and the workflow's window guard waits until 08:16 IST. GitHub's
  own cron for that workflow arrives hours late and is kept only as a backstop.

  StartCalendarInterval fires in the Mac's LOCAL timezone, which must be IST. If the
  Mac is asleep at 08:00, launchd fires the job when it wakes; dispatch.ts skips it
  after 15:35 IST, when AlgoTest would refuse the login anyway. If the Mac is off,
  nothing fires and the GitHub backstop covers it.

  launchd's environment has neither the repo's .env nor the shell PATH: .env is sourced
  for TELEGRAM_* (the failure alert), PATH gets Homebrew for `gh` and the fnm default
  Node 20 for tsx. Bun cannot run this: it lacks process.loadEnvFile, which
  readTelegramConfig() calls.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-trading-agent.broker-login</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>set -a; source /Users/rahul/Projects/ai-trading-agent/.env; set +a; export PATH=/Users/rahul/.local/share/fnm/aliases/default/bin:/opt/homebrew/bin:$PATH; cd /Users/rahul/Projects/ai-trading-agent/packages/broker-login &amp;&amp; ./node_modules/.bin/tsx src/dispatch.ts</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/rahul/Library/Logs/ai-trading-agent/broker-login.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rahul/Library/Logs/ai-trading-agent/broker-login.log</string>
</dict>
</plist>
