<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  At login, and whenever a volume appears under /Volumes: attach the APFS disk image on
  the external SSD that holds TRADING_DATA_ROOT (BL-034). `tdata mount` is idempotent -
  "already mounted" is a no-op - so the extra runs this triggers (attaching the image
  itself changes /Volumes) cost nothing. With the SSD unplugged it exits 1 and logs why;
  plugging the SSD in fires it again.

  Every reader and writer refuses an unmounted root (trading_data.db.check_mounted), so
  without this job the evening collection and the dashboard's APIs fail loudly instead
  of writing somewhere else.

  launchd provides neither the repo .env (TRADING_DATA_ROOT, TRADING_DATA_IMAGE) nor
  the shell PATH (uv lives in ~/.local/bin).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-trading-agent.trading-data-mount</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>set -a; source /Users/rahul/Projects/ai-trading-agent/.env; set +a; export PATH=/Users/rahul/.local/bin:/opt/homebrew/bin:$PATH; cd /Users/rahul/Projects/ai-trading-agent/packages/trading-data &amp;&amp; uv run --quiet tdata mount</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>WatchPaths</key>
    <array>
        <string>/Volumes</string>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/rahul/Library/Logs/ai-trading-agent/trading-data-mount.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rahul/Library/Logs/ai-trading-agent/trading-data-mount.log</string>
</dict>
</plist>
