<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  08:05 IST weekdays: log Fyers in headlessly and store the token in broker_tokens, so the
  dashboard, the server and `mbt` have a fresh one before the 09:15 open. Fyers resets every
  token at 06:00 IST, so any time after that works; this is separate from the AlgoTest
  login (Angel One / Finvasia) so neither can block the other.

  Needs FYERS_CLIENT_ID, FYERS_PIN, FYERS_TOTP_SECRET, FYERS_APP_ID, FYERS_APP_SECRET and
  DATABASE_URL (Postgres up) in the repo .env. On failure it sends a Telegram alert and the
  dashboard's "Login with Fyers" button stays the manual fallback.

  Asleep at 08:05: launchd runs it on wake. Off: nothing runs.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-trading-agent.fyers-login</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>set -a; source /Users/rahul/Projects/ai-trading-agent/.env; set +a; export PATH=/Users/rahul/.local/share/fnm/aliases/default/bin:/opt/homebrew/bin:$PATH; cd /Users/rahul/Projects/ai-trading-agent/packages/broker-login &amp;&amp; ./node_modules/.bin/tsx src/fyers.ts --store</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/rahul/Library/Logs/ai-trading-agent/fyers-login.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rahul/Library/Logs/ai-trading-agent/fyers-login.log</string>
</dict>
</plist>
