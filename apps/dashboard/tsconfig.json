{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "esModuleInterop": true,
    "allowJs": true,
    "isolatedModules": true
  },
  "include": ["next-env.d.ts", "src/**/*", ".next/types/**/*.ts", ".next-prod/types/**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
