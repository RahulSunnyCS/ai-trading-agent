{
  "name": "ai-trading-agent",
  "version": "0.1.0",
  "description": "Paper-trading research platform for weekly index options strategies on Indian markets",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter @ata/server dev",
    "sim": "bun run --filter @ata/server sim",
    "start": "bun scripts/dev-stack.mjs research",
    "start:backend": "bun scripts/dev-stack.mjs backends",
    "start:frontend": "bun scripts/dev-stack.mjs frontend",
    "stop:research": "bun scripts/dev-stack.mjs stop",
    "start:server": "bun run --filter @ata/server start",
    "migrate": "bun run --filter @ata/server migrate",
    "replay": "bun run --filter @ata/server replay",
    "backtest": "bun run --filter @ata/server backtest",
    "test": "bun run --workspaces test",
    "test:unit": "bun run --filter @ata/server test:unit",
    "test:integration": "bun run --filter @ata/server test:integration",
    "test:watch": "bun run --filter @ata/server test:watch",
    "test:coverage": "bun run --filter @ata/server test:coverage",
    "test:e2e": "bun run --filter @ata/dashboard test:e2e",
    "py:api": "cd packages/option-backtesting && uv run obt-api",
    "typecheck": "bun run --filter @ata/server typecheck",
    "lint": "biome lint . --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true",
    "lint:fix": "biome lint --write . --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true",
    "format": "biome format --write . --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "concurrently": "^10.0.5",
    "lefthook": "^2.1.6"
  },
  "trustedDependencies": ["esbuild", "msgpackr-extract", "playwright"]
}
